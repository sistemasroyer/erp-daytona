# ============================================================
# ERP DAYTONA — Variables de Entorno
# Copiar a .env y completar valores reales
# ============================================================

# Aplicación
NODE_ENV=development
PORT=3000
APP_NAME="ERP Daytona"
APP_URL=http://localhost:3000

# Base de datos PostgreSQL
DATABASE_URL="postgresql://erp_user:erp_password@localhost:5432/erp_daytona?schema=public"

# JWT — Tokens
JWT_SECRET=cambiar_por_secreto_muy_largo_y_seguro_minimo_64_caracteres_aleatorios
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=otro_secreto_diferente_para_refresh_tokens_minimo_64_caracteres
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# SUNAT / Facturación Electrónica
SUNAT_MODE=mock
# mock  → CDR simulado, XML UBL 2.1 real, sin envío externo
# real  → Envío real al OSE/SUNAT

SUNAT_OSE_URL=https://ose.tuproveedor.pe/api/enviar
SUNAT_CERT_PATH=/certs/empresa.pfx
SUNAT_CERT_PASSWORD=password_del_certificado
SUNAT_RUC_EMPRESA=20123456789
SUNAT_CLAVE_SOL_USUARIO=SUNAT_SOL_USUARIO
SUNAT_CLAVE_SOL_PASSWORD=SUNAT_SOL_PASSWORD
SUNAT_ENDPOINT_BETA=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
SUNAT_ENDPOINT_PROD=https://e-factura.sunat.gob.pe/ol-ti-itcpfegem/billService

# API Peru (RUC / DNI)
PERU_API_PROVIDER=mock
# mock     → datos simulados para desarrollo
# apiinti  → ApiInti (apiinti.dev)
# apidni   → APIDNI (apidni.com)
PERU_API_KEY=tu_api_key_aqui
PERU_API_URL=https://api.apiinti.dev

# Tipo de Cambio
TIPO_CAMBIO_FUENTE=manual
# manual → ingreso manual en el sistema
# sunat  → consulta automática API SUNAT

# Seguridad
BCRYPT_ROUNDS=12
RATE_LIMIT_LOGIN=10
RATE_LIMIT_GENERAL=100
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Logs
LOG_LEVEL=info
# error | warn | info | debug

# Frontend URL (para CORS y redirecciones)
FRONTEND_URL=http://localhost:5173

# BullMQ — Reintentos
SUNAT_JOB_RETRIES=5
SUNAT_JOB_BACKOFF_DELAY=120000
PDF_JOB_RETRIES=3

# Almacenamiento de certificados y PDFs
STORAGE_PATH=./storage
CERTS_PATH=./storage/certs
PDFS_PATH=./storage/pdfs
XMLS_PATH=./storage/xmls
