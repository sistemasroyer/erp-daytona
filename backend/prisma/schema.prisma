model tbl_cajas {
  id                   String   @id @default(uuid())
  id_punto_venta       String
  nombre               String   @db.VarChar(100)
  descripcion          String?  @db.VarChar(300)
  activo               Boolean  @default(true)
  estado               Boolean  @default(true)
  eliminado            Boolean  @default(false)
  fecha_creacion       DateTime @default(now())
  fecha_modificacion   DateTime @updatedAt
  usuario_creacion     String?  @db.VarChar(36)
  usuario_modificacion String?  @db.VarChar(36)

  punto_venta tbl_puntos_venta      @relation(fields: [id_punto_venta], references: [id])
  aperturas   tbl_cajas_aperturas[]

  @@index([id_punto_venta])
  @@map("tbl_cajas")
}

model tbl_cajas_aperturas {
  id                   String     @id @default(uuid())
  id_caja              String
  id_usuario           String
  monto_apertura       Decimal    @db.Decimal(12, 2)
  monto_cierre         Decimal?   @db.Decimal(12, 2)
  monto_sistema        Decimal?   @db.Decimal(12, 2)
  diferencia           Decimal?   @db.Decimal(12, 2)
  observaciones_cierre String?    @db.VarChar(500)
  fecha_apertura       DateTime   @default(now())
  fecha_cierre         DateTime?
  estado               EstadoCaja @default(abierta)
  estado_registro      Boolean    @default(true)
  eliminado            Boolean    @default(false)
  fecha_creacion       DateTime   @default(now())
  fecha_modificacion   DateTime   @updatedAt
  usuario_creacion     String?    @db.VarChar(36)
  usuario_modificacion String?    @db.VarChar(36)

  caja       tbl_cajas              @relation(fields: [id_caja], references: [id])
  usuario    tbl_usuarios           @relation(fields: [id_usuario], references: [id])
  movimientos tbl_movimientos_caja[]

  @@index([id_caja])
  @@index([id_usuario])
  @@index([estado])
  @@map("tbl_cajas_aperturas")
}

model tbl_movimientos_caja {
  id                   String             @id @default(uuid())
  id_caja_apertura     String
  tipo                 TipoMovimientoCaja
  concepto             String             @db.VarChar(300)
  monto                Decimal            @db.Decimal(12, 2)
  id_referencia        String?            @db.VarChar(36)
  tipo_referencia      String?            @db.VarChar(50)
  id_usuario           String
  fecha                DateTime           @default(now())

  caja_apertura tbl_cajas_aperturas @relation(fields: [id_caja_apertura], references: [id])
  usuario       tbl_usuarios        @relation(fields: [id_usuario], references: [id])

  @@index([id_caja_apertura])
  @@index([fecha])
  @@map("tbl_movimientos_caja")
}

// ============================================================
// TIPO DE CAMBIO
