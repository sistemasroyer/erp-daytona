// ============================================================
// SUNAT
// ============================================================

model tbl_sunat_envios {
  id                   String      @id @default(uuid())
  id_venta             String
  tipo_documento       String      @db.VarChar(5)
  identificador        String      @db.VarChar(100)
  fecha_envio          DateTime?
  intento_numero       Int         @default(0)
  estado               EstadoSunat @default(pendiente)
  error_mensaje        String?     @db.VarChar(500)
  codigo_hash          String?     @db.VarChar(200)
  enlace               String?     @db.VarChar(500)
  enlace_pdf           String?     @db.VarChar(500)
  enlace_xml           String?     @db.VarChar(500)
  enlace_cdr           String?     @db.VarChar(500)
  estado_registro      Boolean     @default(true)
  eliminado            Boolean     @default(false)
  fecha_creacion       DateTime    @default(now())
  fecha_modificacion   DateTime    @updatedAt
  usuario_creacion     String?     @db.VarChar(36)
  usuario_modificacion String?     @db.VarChar(36)

  venta     tbl_ventas              @relation(fields: [id_venta], references: [id])
  respuestas tbl_sunat_respuestas[]

  @@index([id_venta])
  @@index([estado])
  @@map("tbl_sunat_envios")
}

model tbl_sunat_respuestas {
  id                    String   @id @default(uuid())
  id_envio              String
  codigo_respuesta      String?  @db.VarChar(10)
  descripcion_respuesta String?  @db.VarChar(500)
  observaciones         String?  @db.VarChar(500)
  es_exitoso            Boolean  @default(false)
  respuesta_raw         Json?
  fecha_respuesta       DateTime @default(now())

  envio tbl_sunat_envios @relation(fields: [id_envio], references: [id])

  @@index([id_envio])
  @@map("tbl_sunat_respuestas")
}
